# Frontend environment variables (copy to .env and adjust per environment)

# Base URL prefix used by the frontend to build API requests.
# In development, keep this as "/api" to leverage Vite dev proxy.
VITE_API_BASE_URL=/api

# Dev-only: Vite proxy target for API requests (used by vite.config.ts)
# Point this to your backend server in development.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# WebSocket endpoint for real-time features (notifications, orders)
VITE_WS_URL=ws://localhost:8000/ws/events

# Optional: Enable local mocks instead of real API (feature flag)
VITE_ENABLE_MOCKS=false

# Security: Cookie-based auth options
# To use Django session cookies in dev, enable credentials.
# When enabled, the API client automatically turns on CSRF protection
# and sends the CSRF header for unsafe methods.
VITE_SEND_CREDENTIALS=false
VITE_AUTH_USE_COOKIES=false
VITE_CSRF_COOKIE_NAME=csrftoken
VITE_CSRF_HEADER_NAME=X-CSRFToken

# Google OAuth (frontend)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_ALLOW_LOCALHOST=true

# Media assets (uploads served by Django)
VITE_MEDIA_BASE_URL=http://localhost:8000

# Feature flags / diagnostics
VITE_ENABLE_REALTIME_LOGGING=false
VITE_ENABLE_DEBUG_TOOLS=false
